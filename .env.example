# Consultation Recorder - configuration. Copy to .env and edit.
# Every value has a safe default; the ones marked REQUIRED must be set for a real deployment.

# ---------------------------------------------------------------- storage
# MongoDB holds metadata (doctors, patients, consultations, transcripts) and, with
# AUDIO_STORE=gridfs, the audio files too. For the hospital pilot this MUST be a MongoDB
# running inside the hospital network, e.g. mongodb://127.0.0.1:27017
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=doctor_patient_conversations

# Where finished recordings are kept:
#   gridfs - in MongoDB (GridFS bucket "audio") next to the metadata  [default]
#   disk   - as files under DATA_DIR/recordings/<consultationId>/
AUDIO_STORE=gridfs
# Local folder for upload staging (and the audio itself when AUDIO_STORE=disk).
DATA_DIR=./data
# Keep the small upload parts after a recording is joined (debugging only).
KEEP_CHUNKS_AFTER_SAVE=false

# The app shows a warning banner when the database host looks external to the hospital
# (for example MongoDB Atlas). auto = decide from the host name; true/false = override
# after the hospital has confirmed where the database runs.
DB_IS_HOSPITAL_INTERNAL=auto
# Extra host names to treat as hospital-internal (comma separated).
TRUSTED_DB_HOSTS=

# ---------------------------------------------------------------- sign-in
# REQUIRED: long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_HOURS=12
# Doctors can create their own account on the sign-up page (#/signup).
# Each account only ever sees its own patients and consultations.
SIGNUP_ENABLED=true
# Strongly recommended for the hospital: set a code and give it only to pilot doctors.
# Blank = anyone who can reach the server can create an account.
SIGNUP_CODE=
# true when the app is served over HTTPS (required for microphone access from other machines)
COOKIE_SECURE=false

# ---------------------------------------------------------------- branding
APP_TITLE=Consultation Recorder
INSTITUTION_NAME=IIIT Hyderabad
# Principal Investigator, shown in the footer after the team names
PI_NAME=Parameshwari Krishnamurthy
# Names shown in the footer (comma separated)
TEAM_NAMES=Varun, Akash, Jaswanth
# branding/logo.png = square emblem shown top-left (IIIT-H banyan tree)
BRANDING_DIR=./branding

# ---------------------------------------------------------------- patients
# true: a patient must be chosen or added before Start (team decision).
# false: recording may start with "Patient not entered" (the original brief).
REQUIRE_PATIENT=true

# ---------------------------------------------------------------- consent prompt
# This is only a reminder in the app. It does NOT replace the hospital's consent process.
#   off      - nothing shown
#   reminder - short line under the Start button (default)
#   confirm  - doctor must tick a box before Start; the tick is stored with the consultation
CONSENT_MODE=reminder
CONSENT_TEXT=Before recording, follow the hospital's consent process for this consultation.

# ---------------------------------------------------------------- audio capture
# raw     - browser echo cancellation / noise suppression / auto-gain OFF: the saved
#           original is the microphone signal as captured (recommended; default)
# browser - let the browser apply its call-style processing during capture
AUDIO_CAPTURE_PROCESSING=raw
# Opus bitrate in bits/s (128000 is effectively transparent for speech)
AUDIO_BITRATE=128000
# Size of each upload part. Smaller = less audio at risk if the browser crashes.
UPLOAD_CHUNK_SECONDS=5
# A recording with no new audio for this long is shown as "interrupted".
STALE_RECORDING_MINUTES=2

# ---------------------------------------------------------------- post-processing (all local)
# Transcription: none | faster-whisper (local; pip install -r requirements-transcription.txt)
TRANSCRIPTION_ENGINE=none
# tiny | base | small | medium | large-v3   (bigger = better and slower; small is a good CPU default)
WHISPER_MODEL=small
# auto = NVIDIA GPU if available (needs nvidia-cublas-cu12 + nvidia-cudnn-cu12), else CPU
WHISPER_DEVICE=auto
# auto = int8 on CPU, float16 on GPU
WHISPER_COMPUTE_TYPE=auto
# Blank = auto-detect. Or force one language, e.g. en, hi, te
WHISPER_LANGUAGE=
# true = detect the language for each segment, so mixed English / Hindi / Telugu
# consultations keep each line in its own language (recommended). false = one language
# for the whole recording (other languages then get translated or dropped).
WHISPER_MULTILINGUAL=true
# Languages that may be spoken. Each part of the recording is assigned one of THESE only,
# which stops short segments being read as e.g. Chinese or Urdu.
WHISPER_LANGUAGES=en,hi,te
# Model weights folder. Download once (python -m app.manage download-model), then set
# HF_HUB_OFFLINE=1 so the server never contacts the internet.
MODEL_DIR=./models
HF_HUB_OFFLINE=0

# Speaker labels for the transcript: none | sherpa-onnx | pyannote
#   pyannote    - pyannote speaker-diarization-community-1 (CC-BY-4.0), stronger; runs in its own
#                 environment (.venv-diar: PyTorch + pyannote.audio). One-time setup: accept the
#                 model's conditions at huggingface.co/pyannote/speaker-diarization-community-1 and
#                 set HF_TOKEN; afterwards it is cached in MODEL_DIR and runs offline.
#   sherpa-onnx - lighter (ONNX, no PyTorch); python -m app.manage download-diarization-models
# Labels are anonymous (Speaker A, B, ...). The audio itself stays ONE file.
DIARIZATION_ENGINE=none
# Blank = detect the number of speakers automatically. Set 2 if consultations always have two people.
DIARIZATION_NUM_SPEAKERS=
# CPU threads for diarization (default: half the cores)
DIARIZATION_THREADS=
# pyannote settings
DIARIZATION_PYTHON=
PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
HF_TOKEN=
# sherpa-onnx settings
DIARIZATION_THRESHOLD=0.5
DIARIZATION_SEGMENTATION_MODEL=models/diarization/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
DIARIZATION_EMBEDDING_MODEL=models/diarization/wespeaker_en_voxceleb_resnet34_LM.onnx
